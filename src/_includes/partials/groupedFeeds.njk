{% for group, items in groupedFeeds %}
<details>
  <summary>
    <div class="el-text-button">
      <p><strong>{{ group }}</strong></p>
      <div class="button-group">
        <button class="button" data-open>Open</button>
        <a class="button" href="/groups/{{ group | slug }}/">View</a>
      </div>
    </div>
  </summary>
  <ul class="feed-list">
    {% for item in items %}
    <li>
      <div class="el-text-button">
        <p>{{ item.title }}</p>
        {% for blog in rss %}
          {% if blog.title == item.title %}
          <i data-unread>{{ blog.items | length }}</i>
          {% endif %}
        {% endfor %}
        
        <a class="button" href="/feed/{{ item.title | slug }}">View</a>
      </div>
    </li>
    {% endfor %}
  </ul>
</details>
{% endfor %}
